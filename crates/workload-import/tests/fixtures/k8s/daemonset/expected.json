{
  "log-agent": {
    "scale": "per_node",
    "restart": "always",
    "expose": "environment",
    "placement": {},
    "volumes": {
      "logs": {
        "type": "host_path",
        "path": "/var/log",
        "create": false
      },
      "state": {
        "type": "host_path",
        "path": "/var/lib/log-agent",
        "create": true
      }
    },
    "containers": [
      {
        "name": "agent",
        "image": "fluent/fluent-bit:3.1",
        "command": [],
        "args": [
          "--config=/etc/agent/agent.conf"
        ],
        "env": {},
        "ports": [],
        "mounts": [
          {
            "volume": "logs",
            "path": "/var/log",
            "read_only": true
          },
          {
            "volume": "state",
            "path": "/var/lib/agent",
            "read_only": false
          }
        ],
        "resources": {
          "limits": {
            "cpu_millis": 200,
            "memory_bytes": 100000000
          },
          "requests": {}
        },
        "capabilities": [],
        "read_only_root_fs": false
      }
    ]
  }
}

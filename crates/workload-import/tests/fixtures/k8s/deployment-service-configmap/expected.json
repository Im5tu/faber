{
  "web": {
    "scale": {
      "replicas": 3
    },
    "restart": "always",
    "expose": "cluster",
    "placement": {},
    "stop_grace_secs": 45,
    "volumes": {},
    "containers": [
      {
        "name": "web",
        "image": "registry.example.com/shop/web:1.4.2",
        "command": [],
        "args": [
          "--listen=:8080",
          "--db=postgres://db.shop.svc:5432/shop",
          "--literal=$(PORT)"
        ],
        "env": {
          "APP_DB_HOST": "db.shop.svc",
          "APP_DB_PORT": "5432",
          "APP_LOG_LEVEL": "debug",
          "APP_feature.flags": "search,checkout",
          "DATABASE_URL": "postgres://db.shop.svc:5432/shop",
          "DB_HOST": "db.shop.svc",
          "PORT": "8080"
        },
        "user": "1000:1000",
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "protocol": "tcp"
          },
          {
            "name": "metrics",
            "port": 9090,
            "protocol": "tcp"
          }
        ],
        "mounts": [],
        "resources": {
          "limits": {
            "cpu_millis": 1000,
            "memory_bytes": 536870912
          },
          "requests": {
            "cpu_millis": 250,
            "memory_bytes": 134217728
          }
        },
        "capabilities": [
          "NET_BIND_SERVICE"
        ],
        "read_only_root_fs": true,
        "liveness": {
          "action": {
            "type": "tcp",
            "port": 8080
          },
          "initial_delay_secs": 10,
          "period_secs": 10,
          "timeout_secs": 1,
          "success_threshold": 1,
          "failure_threshold": 5
        },
        "readiness": {
          "action": {
            "type": "http",
            "port": 8080,
            "path": "/healthz",
            "scheme": "http",
            "headers": {}
          },
          "initial_delay_secs": 0,
          "period_secs": 5,
          "timeout_secs": 1,
          "success_threshold": 1,
          "failure_threshold": 3
        }
      }
    ]
  }
}

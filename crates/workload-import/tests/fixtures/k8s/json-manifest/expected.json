{
  "cache": {
    "scale": {
      "replicas": 1
    },
    "restart": "always",
    "expose": "environment",
    "placement": {
      "node": "node-1"
    },
    "volumes": {
      "data": {
        "type": "named",
        "name": "cache-data",
        "per_replica": false
      }
    },
    "containers": [
      {
        "name": "redis",
        "image": "redis:7.4",
        "command": [],
        "args": [
          "--maxmemory",
          "256mb"
        ],
        "env": {},
        "ports": [
          {
            "port": 6379,
            "protocol": "tcp"
          }
        ],
        "mounts": [
          {
            "volume": "data",
            "path": "/data",
            "read_only": false
          }
        ],
        "resources": {
          "limits": {
            "cpu_millis": 500,
            "memory_bytes": 268435456
          },
          "requests": {}
        },
        "capabilities": [],
        "read_only_root_fs": false,
        "liveness": {
          "action": {
            "type": "exec",
            "command": [
              "redis-cli",
              "ping"
            ]
          },
          "initial_delay_secs": 0,
          "period_secs": 10,
          "timeout_secs": 2,
          "success_threshold": 1,
          "failure_threshold": 3
        }
      }
    ]
  }
}

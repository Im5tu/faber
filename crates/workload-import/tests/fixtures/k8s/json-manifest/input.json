{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {"name": "cache", "labels": {"app": "cache"}},
  "spec": {
    "replicas": 1,
    "selector": {"matchLabels": {"app": "cache"}},
    "template": {
      "metadata": {"labels": {"app": "cache"}},
      "spec": {
        "nodeName": "node-1",
        "containers": [
          {
            "name": "redis",
            "image": "redis:7.4",
            "args": ["--maxmemory", "256mb"],
            "ports": [{"containerPort": 6379, "hostPort": 6379}],
            "resources": {"limits": {"cpu": 0.5, "memory": 268435456}},
            "livenessProbe": {
              "exec": {"command": ["redis-cli", "ping"]},
              "timeoutSeconds": 2
            },
            "volumeMounts": [{"name": "data", "mountPath": "/data"}]
          }
        ],
        "volumes": [
          {"name": "data", "persistentVolumeClaim": {"claimName": "cache-data"}}
        ]
      }
    }
  }
}

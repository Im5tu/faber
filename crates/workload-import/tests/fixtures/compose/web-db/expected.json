{
  "db": {
    "scale": {
      "replicas": 1
    },
    "restart": "always",
    "expose": "environment",
    "placement": {},
    "stop_grace_secs": 60,
    "volumes": {
      "pgdata": {
        "type": "named",
        "name": "pgdata",
        "per_replica": false
      },
      "v0": {
        "type": "host_path",
        "path": "/srv/app/initdb",
        "create": true
      }
    },
    "containers": [
      {
        "name": "db",
        "image": "postgres:16",
        "command": [],
        "args": [],
        "env": {
          "POSTGRES_DB": "shop",
          "POSTGRES_PASSWORD": "shop",
          "POSTGRES_USER": "shop"
        },
        "ports": [],
        "mounts": [
          {
            "volume": "pgdata",
            "path": "/var/lib/postgresql/data",
            "read_only": false
          },
          {
            "volume": "v0",
            "path": "/docker-entrypoint-initdb.d",
            "read_only": true
          }
        ],
        "resources": {
          "limits": {},
          "requests": {}
        },
        "capabilities": [
          "CHOWN",
          "SETUID",
          "SETGID",
          "DAC_OVERRIDE",
          "FOWNER"
        ],
        "read_only_root_fs": false,
        "readiness": {
          "action": {
            "type": "exec",
            "command": [
              "/bin/sh",
              "-c",
              "pg_isready -U shop"
            ]
          },
          "initial_delay_secs": 30,
          "period_secs": 10,
          "timeout_secs": 5,
          "success_threshold": 1,
          "failure_threshold": 5
        }
      }
    ]
  },
  "web": {
    "scale": {
      "replicas": 2
    },
    "restart": "always",
    "expose": "cluster",
    "placement": {},
    "volumes": {},
    "containers": [
      {
        "name": "web",
        "image": "ghcr.io/acme/shop-web:1.4.2",
        "command": [],
        "args": [
          "serve",
          "--listen",
          "0.0.0.0:8080"
        ],
        "env": {
          "DATABASE_URL": "postgres://shop:shop@db:5432/shop",
          "LOG_LEVEL": "info",
          "WORKERS": "4"
        },
        "ports": [
          {
            "port": 8080,
            "protocol": "tcp"
          }
        ],
        "mounts": [],
        "resources": {
          "limits": {
            "cpu_millis": 500,
            "memory_bytes": 268435456
          },
          "requests": {}
        },
        "capabilities": [],
        "read_only_root_fs": false
      }
    ]
  }
}

{
  "db": {
    "containers": [
      {
        "name": "db",
        "image": "postgres:16",
        "env": { "PGDATA": "/var/lib/postgresql/data" }
      }
    ]
  },
  "web": {
    "scale": { "replicas": 2 },
    "containers": [
      {
        "name": "web",
        "image": "nginx:1.27",
        "ports": [{ "name": "http", "port": 8080 }]
      }
    ]
  }
}
